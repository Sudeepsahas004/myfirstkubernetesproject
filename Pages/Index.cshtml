@page
@model IndexModel

@{
    ViewData["Title"] = "DevOps Learning Portal";
}

<section class="hero">
    <h1>Welcome to DevOps Learning Portal</h1>
    <p>Learn Docker, Kubernetes, Azure and CI/CD.</p>
    <a href="#technologies" class="btn">Explore Technologies</a>
</section>

<section id="technologies" class="container mt-5">
    <h2 class="text-center mb-4">Our Technologies</h2>

    <div class="row">
        <div class="col-md-3">
            <div class="card p-3">
                <h3>Docker</h3>
                <p>Build and manage containers.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h3>Kubernetes</h3>
                <p>Orchestrate containerized applications.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h3>Azure</h3>
                <p>Deploy applications in the cloud.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3">
                <h3>CI/CD</h3>
                <p>Automate application deployments.</p>
            </div>
        </div>
    </div>
</section>
